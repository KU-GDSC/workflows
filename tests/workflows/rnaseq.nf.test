nextflow_workflow {
    name "Test RNASEQ"
    script "workflows/rnaseq.nf"
    workflow "RNASEQ"

    test("D. mel simulated 100k -- bowtie2 -- strand detection -- PE -- compressed input") {
        when {
            params {
                fasta = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.dna_sm.primary_assembly.2L.fa"
                gtf = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.110.2L.gtf"
                sample_folder = "/kuhpc/work/sjmac/observer/simulated_data/rnaseq/d_melanogaster/100k/"
                rsem_aligner = "bowtie2"
                read_type = "PE"
                pubdir = "tests/dmel_bowtie2_auto_PE_zip"
                pipeline = "rnaseq"
            }
        }

        then {
            assertAll (
                { assert snapshot(workflow.out.merged_genes).match("bowtie_auto_pe_zip") },
                { assert workflow.success }
                )
            }
    }

    test("D. mel simulated 100k -- bowtie2 -- strand detection -- SE -- compressed input") {
        when {
            params {
                fasta = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.dna_sm.primary_assembly.2L.fa"
                gtf = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.110.2L.gtf"
                sample_folder = "/kuhpc/work/sjmac/observer/simulated_data/rnaseq/d_melanogaster/100k/SE"
                rsem_aligner = "bowtie2"
                read_type = "SE"
                pubdir = "tests/dmel_bowtie2_auto_SE_zip"
                pipeline = "rnaseq"
            }
        }

        then {
            assertAll (
                { assert snapshot(workflow.out.merged_genes).match("bowtie_auto_se_zip") },
                { assert workflow.success }
                )
            }

    }

    test("D. mel simulated 100k -- STAR -- skip strand -- PE -- compressed input") {
        when {
            params {
                fasta = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.dna_sm.primary_assembly.2L.fa"
                gtf = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.110.2L.gtf"
                sample_folder = "/kuhpc/work/sjmac/observer/simulated_data/rnaseq/d_melanogaster/100k/"
                rsem_aligner = "star"
                read_type = "PE"
                strandedness = "non_stranded"
                pubdir = "tests/dmel_star_skip_PE_zip"
                pipeline = "rnaseq"
            }
        }

        then {
            assertAll (
                { assert snapshot(workflow.out.merged_genes).match("star_skip_pe_zip") },
                { assert workflow.success }
                )
            }
     }

    test("D. mel simulated 100k -- STAR -- skip strand -- SE -- compressed input") {
        when {
            params {
                fasta = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.dna_sm.primary_assembly.2L.fa"
                gtf = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.110.2L.gtf"
                sample_folder = "/kuhpc/work/sjmac/observer/simulated_data/rnaseq/d_melanogaster/100k/SE"
                rsem_aligner = "star"
                read_type = "SE"
                pubdir = "tests/dmel_star_skip_SE_zip"
                pipeline = "rnaseq"
            }
        }

        then {
            assertAll (
                { assert snapshot(workflow.out.merged_genes).match("star_skip_se_zip") },
                { assert workflow.success }
                )
            }

     }

    test("D. mel simulated 100k -- bowtie2 -- skip strand -- PE -- uncompressed input") {
        when {
            params {
                fasta = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.dna_sm.primary_assembly.2L.fa"
                gtf = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.110.2L.gtf"
                sample_folder = "/kuhpc/work/sjmac/observer/simulated_data/rnaseq/d_melanogaster/100k/"
                rsem_aligner = "bowtie2"
                read_type = "PE"
                strandedness = "non_stranded"
                extension = ".fastq"
                pubdir = "tests/dmel_bowtie2_skip_PE_unzip"
                pipeline = "rnaseq"
            }
        }

        then {
            assertAll (
                { assert snapshot(workflow.out.merged_genes).match("bowtie_skip_pe_unzip") },
                { assert workflow.success }
                )
            }

      }

    test("D. mel simulated 100k -- bowtie2 -- skip strand -- SE -- uncompressed input") {
        when {
            params {
                fasta = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.dna_sm.primary_assembly.2L.fa"
                gtf = "/kuhpc/work/sjmac/observer/references/d_melanogaster/ensembl/v110/Drosophila_melanogaster.BDGP6.46.110.2L.gtf"
                sample_folder = "/kuhpc/work/sjmac/observer/simulated_data/rnaseq/d_melanogaster/100k/SE"
                rsem_aligner = "bowtie2"
                read_type = "SE"
                strandedness = "non_stranded"
                extension = ".fastq"
                pubdir = "tests/dmel_bowtie2_skip_SE_unzip"
                pipeline = "rnaseq"
            }
        }

        then {
            assertAll (
                { assert snapshot(workflow.out.merged_genes).match("bowtie_skip_se_unzip") },
                { assert workflow.success }
                )
            }

     }
}
